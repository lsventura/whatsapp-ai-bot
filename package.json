{
  "name": "whatsapp-ai-bot",
  "version": "1.0.0",
  "description": "Assistente de WhatsApp com IA (Cloud API oficial): respostas ancoradas em base de conhecimento, memória por contato, handoff humano, rate limit e automação de formulários com Playwright.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "vitest run tests/e2e",
    "chat": "tsx src/cli.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "openai",
    "llm",
    "playwright",
    "typescript",
    "whatsapp-cloud-api",
    "automacao"
  ],
  "author": "Leonardo Sanches (@lsventura)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "repository": { "type": "git", "url": "git+https://github.com/lsventura/whatsapp-ai-bot.git" },
  "engines": {
    "node": ">=20.12"
  }
}
