# ============================================================
# Copie para .env e preencha. NUNCA faça commit do .env.
# ============================================================

PORT=3000
LOG_LEVEL=info

# --- WhatsApp Cloud API (Meta) -------------------------------
# Token de verificação: qualquer string que você inventar; use a mesma ao configurar o webhook no painel da Meta.
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-secreto
# Token de acesso (permanente, de usuário do sistema) e ID do número de telefone — painel Meta > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret (Configurações do app > Básico). Usado para validar a assinatura X-Hub-Signature-256 do webhook.
# Em produção é OBRIGATÓRIO preencher.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v27.0
# Reinsere o 9 em celulares BR que chegam sem ele no webhook (evita erro 131030 no número de teste)
WHATSAPP_BR_ADD_NINTH_DIGIT=true

# --- LLM (qualquer API compatível com OpenAI) ----------------
# Sem LLM_API_KEY o bot funciona em "modo FAQ" (responde só com a base de conhecimento).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_MS=30000
# Máximo de chamadas ao LLM em paralelo (protege seu limite de taxa/custo)
LLM_MAX_CONCURRENCY=4
# Exemplos de outros provedores:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama local: LLM_BASE_URL=http://localhost:11434/v1  (LLM_API_KEY=ollama)

# --- Comportamento do bot ------------------------------------
# Menu numerado (oi / menu / 1,2,3...). Sem LLM ele responde cumprimentos com o menu.
MENU_ENABLED=true
BOT_NAME=Assistente
BUSINESS_NAME=Clínica Sorriso Exemplo
# .json ([{pergunta, resposta, tags}]) ou .md (cada "## Título" vira uma entrada)
KNOWLEDGE_FILE=knowledge/faq.json
KNOWLEDGE_TOP_K=3
MEMORY_MAX_TURNS=10
MEMORY_TTL_MINUTES=120

# Handoff para humano
HANDOFF_KEYWORDS=atendente,humano,falar com uma pessoa,falar com alguem,pessoa real
HANDOFF_RESUME_KEYWORDS=/bot,voltar ao bot
HANDOFF_TTL_MINUTES=240
# (opcional) número que recebe um aviso quando alguém pede atendente, ex.: 5511999998888
HANDOFF_NOTIFY_NUMBER=

# Rate limit por contato
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Automação de formulário (Playwright) --------------------
FORM_ENABLED=true
FORM_CONFIG_FILE=examples/form-demo/form.config.json
# false = abre o navegador visível (bom para depurar localmente)
FORM_HEADLESS=true
# Serve o formulário de exemplo em /demo-form (desligue em produção)
SERVE_DEMO_FORM=true
# URL pública/base usada para substituir ${PUBLIC_BASE_URL} no form.config.json
PUBLIC_BASE_URL=http://localhost:3000
